{
  "name": "release-please-action",
  "version": "6.0.1",
  "private": true,
  "description": "automated releases based on conventional commits",
  "keywords": [
    "action",
    "release-please"
  ],
  "homepage": "https://github.com/release-please-oss/release-please-action#readme",
  "bugs": {
    "url": "https://github.com/release-please-oss/release-please-action/issues"
  },
  "license": "Apache-2.0",
  "author": "Ben Coe <bencoe@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/release-please-oss/release-please-action.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "compile": "tsc -p ./tsconfig.app.json",
    "build": "rolldown -c"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "release-please": "^17.1.3",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@vitest/coverage-v8": "^4.1.4",
    "lefthook": "^2.1.5",
    "nock": "^14.0.10",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.60.0",
    "rolldown": "^1.0.0-rc.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "volta": {
    "node": "24.15.0"
  }
}
