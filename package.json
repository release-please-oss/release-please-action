{
  "name": "release-please-action",
  "version": "5.3.2",
  "private": true,
  "description": "automated releases based on conventional commits",
  "keywords": [
    "action",
    "release-please"
  ],
  "homepage": "https://github.com/release-please-oss/release-please-action#readme",
  "bugs": {
    "url": "https://github.com/release-please-oss/release-please-action/issues"
  },
  "license": "Apache-2.0",
  "author": "Ben Coe <bencoe@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/release-please-oss/release-please-action.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "prepare": "lefthook install",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "jest --ci --passWithNoTests=false --coverage",
    "compile": "tsc -p ./tsconfig.app.json",
    "build": "rolldown -c"
  },
  "dependencies": {
    "@actions/core": "^1.10.0",
    "release-please": "^17.1.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.2",
    "jest": "^30.0.5",
    "jest-junit": "^16.0.0",
    "lefthook": "^2.1.5",
    "nock": "^14.0.10",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "rolldown": "^1.0.0-rc.15",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "ultracite": "^7.5.8"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "volta": {
    "node": "24.14.1"
  }
}
