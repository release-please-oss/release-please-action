{
  "name": "release-please-action",
  "version": "6.0.2",
  "private": true,
  "description": "automated releases based on conventional commits",
  "keywords": [
    "action",
    "release-please"
  ],
  "homepage": "https://github.com/release-please-oss/release-please-action#readme",
  "bugs": {
    "url": "https://github.com/release-please-oss/release-please-action/issues"
  },
  "license": "Apache-2.0",
  "author": "Ben Coe <bencoe@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/release-please-oss/release-please-action.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "compile": "tsc -p ./tsconfig.app.json",
    "build": "rolldown -c"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "release-please": "^17.7.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@vitest/coverage-v8": "^4.1.7",
    "lefthook": "^2.1.8",
    "nock": "^14.0.15",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.67.0",
    "rolldown": "^1.0.3",
    "typescript": "^6.0.0",
    "vitest": "^4.1.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0 <12.0.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.16.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
