{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/jest",
    "esModuleInterop": true,
    "types": ["jest", "node"],
    "composite": false,
    "declaration": true,
    "isolatedModules": true
  },
  "include": ["jest.config.ts", "src/**/*.test.ts", "src/**/*.spec.ts", "src/**/*.d.ts"]
}
