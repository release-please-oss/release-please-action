{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboardApproval": true,
  "addLabels": ["dependencies"],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "rebaseWhen": "conflicted",
  "osvVulnerabilityAlerts": true,
  "extends": ["helpers:pinGitHubActionDigestsToSemver"],
  "packageRules": [
    {
      "groupName": "github-actions",
      "matchManagers": ["github-actions"],
      "addLabels": ["github-actions", "no-release"]
    },
    {
      "description": "Our own fork is exempt from the release-age wait, matching pnpm-workspace.yaml",
      "matchPackageNames": ["@release-please-oss/release-please"],
      "minimumReleaseAge": null
    },
    {
      "matchPackageNames": ["node", "@types/node"],
      "versioning": "node"
    },
    {
      "groupName": "npm dependencies",
      "matchManagers": ["npm"],
      "addLabels": ["npm"]
    }
  ]
}
